# =====================================================
# Microservicio de Vehículos - FleetOps
# Archivo de variables de entorno (ejemplo)
#
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo como ".env"
# 2. Completa los valores reales según tu entorno
# 3. NUNCA subas el archivo .env al repositorio (está en .gitignore)
# =====================================================

# =====================================================
# Puertos del microservicio
# API_HOST_PORT: puerto expuesto en el host (EC2 / laptop). Dojo: 18000.
# Dentro del contenedor la app siempre escucha en 8081.
# =====================================================
API_HOST_PORT=8081

# =====================================================
# Base de datos PostgreSQL
# =====================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fleetops_vehicles
DB_USERNAME=fleetops
DB_PASSWORD=fleetops123

# =====================================================
# JWT
# Verificación de tokens firmados por el microservicio
# de Seguridad mediante criptografía asimétrica
# =====================================================
JWT_ALGORITHM=cambiar_por_algoritmo_de_Seguridad

# =====================================================
# Comunicación con otros microservicios
# =====================================================
MAINTENANCE_SERVICE_URL=http://localhost:8083
KAFKA_BOOTSTRAP_SERVERS=kafka:9092 # Cambiar por IP pública del servicio de asignaciones en producción

# =====================================================
# SQS / LocalStack (docker compose local)
# Ver docs/localstack-sqs.md
# =====================================================
SQS_ENABLED=true
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_VEHICLES_QUEUE_URL=http://localhost:4566/000000000000/queue_vehicles
MAINTENANCE_SQS_QUEUE_URL=http://localhost:4566/000000000000/queue_vehicles_maintenance

# =====================================================
# CORS - Orígenes permitidos
# =====================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# =====================================================
# Opciones de desarrollo
# =====================================================
SHOW_SQL=false